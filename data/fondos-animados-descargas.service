# Gestor de descargas de Fondos animados (servicio de systemd de usuario). install.sh cambia
# @BIN_DIR@ por la carpeta de los programas y lo activa.
[Unit]
Description=Fondos animados: gestor de descargas
Documentation=https://github.com/jlcampana/gnome-animated-wallpaper#cola-de-descargas
# Si se cae nada más arrancar una y otra vez, se deja (la app lo vuelve a intentar al abrirse).
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=exec
ExecStart=@BIN_DIR@/fondos-animados --gestor-descargas
# Termina solo cuando la cola se queda sin trabajo (código 0): entonces no se relanza; si se
# cae, sí, y sigue con la cola donde estaba.
Restart=on-failure
RestartSec=5
Nice=5

[Install]
WantedBy=default.target
